# Intentional lab exception: HTTP on localhost, not a public production endpoint.
DEBUG=false
SECRET_KEY=
# Generate and paste a key (never commit .env):
# python -c "import secrets; print(secrets.token_urlsafe(64))"
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_SECURE_SSL=false
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
# Production: SSL=true, real hosts and HTTPS CSRF origins behind a trusted TLS proxy.
# Set INCLUDE_SUBDOMAINS/PRELOAD=true only after confirming the domain policy.
# Increase HSTS_SECONDS to 31536000 once HTTPS policy is ready. See docs/TRIEN_KHAI.md.
DB_ENGINE=postgresql
DB_NAME=inventory
DB_USER=inventory
DB_PASSWORD=
# Separate DB password: python -c "import secrets; print(secrets.token_urlsafe(32))"
DB_HOST=db
DB_PORT=5432
MEDIA_ROOT=/app/media
WEB_PORT=8000
BIND_ADDRESS=127.0.0.1
